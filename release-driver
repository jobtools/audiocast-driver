#!/bin/bash
# Build the AudioCast driver, notarize it with Apple, publish to GitHub Releases,
# refresh Homebrew cask. REPO/CASK_REPO env can override the targets.
#
# Notarization is mandatory here. The AudioCast app installs this package as
# root, so a signed and notarized package is what lets the app refuse anything
# else — and `installer` itself checks nothing. Pass --allow-unsigned to publish
# an unsigned build instead. See ../audiocast/docs/notarization.md for the
# one-time account setup; the notarytool credentials are shared with the sender.
set -euo pipefail

NOTARIZE=1
for arg in "$@"; do
    case "$arg" in
        --allow-unsigned) NOTARIZE=0 ;;
        *) echo "Unknown arg: $arg" >&2; exit 1 ;;
    esac
done

PROJECT_ROOT="$(cd "$(dirname "$0")" && pwd)"
INSTALLER_DIR="${PROJECT_ROOT}/Installer"
VERSION_FILE="${PROJECT_ROOT}/VERSION"

REPO="${REPO:-jobtools/audiocast-driver}"
CASK_REPO="${CASK_REPO:-jobtools/homebrew-tap}"
CASK_SLUG="audiocast-driver"

# --- Preflight ----------------------------------------------------------------
# Everything that can fail is checked before the version bump, because the bump
# is committed: discovering a missing certificate afterwards leaves the repo a
# version ahead with nothing published, and the retry burns another number.
if [[ $NOTARIZE -eq 1 ]]; then
    APP_ID="$(security find-identity -v -p codesigning \
        | sed -n 's/.*"\(Developer ID Application: .*\)"$/\1/p' | head -1)"
    PKG_ID_CERT="$(security find-identity -v \
        | sed -n 's/.*"\(Developer ID Installer: .*\)"$/\1/p' | head -1)"
    for pair in "Developer ID Application:${APP_ID}" "Developer ID Installer:${PKG_ID_CERT}"; do
        kind="${pair%%:*}"; value="${pair#*:}"
        if [[ -z "${value}" ]]; then
            echo "No \"${kind}\" certificate in the login keychain." >&2
            echo "Create one at https://developer.apple.com/account/resources/certificates" >&2
            echo "(or Xcode → Settings → Accounts → Manage Certificates), or re-run with" >&2
            echo "--allow-unsigned. Only the Account Holder can create Developer ID certs." >&2
            exit 1
        fi
    done
    # The driver and the package it ships in must come from the same team, or
    # the notary service rejects the pair.
    APP_TEAM="${APP_ID##*\(}"; APP_TEAM="${APP_TEAM%\)}"
    PKG_TEAM="${PKG_ID_CERT##*\(}"; PKG_TEAM="${PKG_TEAM%\)}"
    if [[ "${APP_TEAM}" != "${PKG_TEAM}" ]]; then
        echo "Team ID mismatch: driver cert is ${APP_TEAM}, installer cert is ${PKG_TEAM}." >&2
        exit 1
    fi
    NOTARY_PROFILE="${AC_NOTARY_PROFILE:-audiocast}"
    if ! xcrun notarytool history --keychain-profile "${NOTARY_PROFILE}" >/dev/null 2>&1; then
        echo "Could not authenticate to the notary service with keychain profile" >&2
        echo "'${NOTARY_PROFILE}'. Store credentials with 'xcrun notarytool store-credentials'," >&2
        echo "or re-run with --allow-unsigned. See ../audiocast/docs/notarization.md." >&2
        exit 1
    fi
    echo ">> Preflight OK (team ${APP_TEAM}, notary profile '${NOTARY_PROFILE}')"
fi

# --- Bump version (last segment +1) ------------------------------------------
CURRENT="$(cat "${VERSION_FILE}")"
IFS='.' read -ra PARTS <<< "${CURRENT}"
LAST_IDX=$((${#PARTS[@]} - 1))
PARTS[${LAST_IDX}]=$((${PARTS[${LAST_IDX}]} + 1))
NEW_VERSION="$(IFS='.'; echo "${PARTS[*]}")"
echo "${NEW_VERSION}" > "${VERSION_FILE}"

VERSION="${NEW_VERSION}"
TAG="v${VERSION}"
PKG_NAME="AudioCast-${VERSION}.pkg"
PKG_PATH="${INSTALLER_DIR}/${PKG_NAME}"

echo ">> Bumped: ${CURRENT} → ${NEW_VERSION}"

# Commit the bump
git -C "${PROJECT_ROOT}" add "${VERSION_FILE}"
if ! git -C "${PROJECT_ROOT}" diff --cached --quiet; then
    GIT_NAME="$(git -C "${PROJECT_ROOT}" config user.name)"
    GIT_EMAIL="$(git -C "${PROJECT_ROOT}" config user.email)"
    git -C "${PROJECT_ROOT}" \
        -c user.name="${GIT_NAME}" -c user.email="${GIT_EMAIL}" \
        commit -q -m "Bump driver to v${VERSION}"
fi

echo ">> Release repo: https://github.com/${REPO}"
echo ">> Cask repo:    https://github.com/${CASK_REPO}"
echo ">> Cask file:    https://github.com/${CASK_REPO}/blob/main/Casks/${CASK_SLUG}.rb"
echo ">> Version:      ${VERSION}"
echo ">> Tag:          ${TAG}"
echo ""

# --- Build .pkg ---------------------------------------------------------------
( cd "${PROJECT_ROOT}" && bash Installer/build_audiocast.sh )
if [[ ! -f "${PKG_PATH}" ]]; then
    echo "Build did not produce ${PKG_PATH}" >&2
    exit 1
fi

# --- Notarize + staple --------------------------------------------------------
# Before the checksum is taken: stapling rewrites the package, so hashing first
# would publish a cask that rejects the file it points at.
if [[ $NOTARIZE -eq 1 ]]; then
    echo ">> Notarizing ${PKG_NAME}..."
    if ! xcrun notarytool submit "${PKG_PATH}" \
            --keychain-profile "${NOTARY_PROFILE}" --wait; then
        echo "Notarization failed, and v${VERSION} is already committed." >&2
        echo "Fix the cause, then re-run — the bump only happens once per run," >&2
        echo "so expect the next attempt to land on the following version." >&2
        exit 1
    fi
    xcrun stapler staple "${PKG_PATH}"
    xcrun stapler validate "${PKG_PATH}"
    echo ">> Gatekeeper assessment"
    spctl --assess --type install --verbose=4 "${PKG_PATH}"
fi

PKG_SHA="$(shasum -a 256 "${PKG_PATH}" | awk '{print $1}')"
echo ">> SHA-256: ${PKG_SHA}"

# --- Push commits + tag to driver repo ---------------------------------------
git -C "${PROJECT_ROOT}" push origin "$(git -C "${PROJECT_ROOT}" rev-parse --abbrev-ref HEAD)" 2>/dev/null || true

# --- GitHub Release ----------------------------------------------------------
RELEASE_NOTES="AudioCast virtual audio driver ${VERSION}.

Single-variant (2 channels) fork of BlackHole, branded as 'AudioCast' in
System Settings → Sound. Bundle ID: com.audiocast.driver.

Install via Homebrew:

    brew tap jobtools/tap
    brew install --cask audiocast-driver

Or download the .pkg directly and double-click."

### Versionless alias so the AudioCast app can hit a stable URL
### (https://github.com/<repo>/releases/latest/download/AudioCast.pkg)
### and always pick the latest, regardless of which version it was
### compiled against. cask still uses the versioned filename.
ALIAS_PATH="${INSTALLER_DIR}/AudioCast.pkg"
cp "${PKG_PATH}" "${ALIAS_PATH}"

if gh release view "${TAG}" --repo "${REPO}" >/dev/null 2>&1; then
    echo ">> Updating release ${TAG}"
    gh release upload "${TAG}" "${PKG_PATH}" "${ALIAS_PATH}" --repo "${REPO}" --clobber
    gh release edit "${TAG}" --repo "${REPO}" --draft=false >/dev/null
else
    echo ">> Creating release ${TAG}"
    gh release create "${TAG}" \
        --repo "${REPO}" \
        --title "AudioCast Driver ${VERSION}" \
        --notes "${RELEASE_NOTES}" \
        "${PKG_PATH}" "${ALIAS_PATH}"
fi
rm -f "${ALIAS_PATH}"

# --- Refresh Homebrew cask ---------------------------------------------------
CASK_DIR="$(mktemp -d -t audiocast-driver-cask.XXXXXX)"
trap 'rm -rf "${CASK_DIR}"' EXIT

echo ">> Refreshing cask in ${CASK_REPO}"
git clone --quiet "git@github.com:${CASK_REPO}.git" "${CASK_DIR}" 2>/dev/null || {
    mkdir -p "${CASK_DIR}"
    cd "${CASK_DIR}"
    git init -q -b main
    git remote add origin "git@github.com:${CASK_REPO}.git"
}
cd "${CASK_DIR}"
mkdir -p Casks

# Nothing about signing reaches users on a notarized build — it installs without
# them doing anything, and how that is achieved is not their problem. The
# unsigned build does need them to know.
if [[ $NOTARIZE -eq 1 ]]; then
    CASK_SIGNING_CAVEAT=""
else
    CASK_SIGNING_CAVEAT='    AudioCast Driver is self-signed (not Apple-notarized).

'
fi
cat > "Casks/${CASK_SLUG}.rb" <<EOF
cask "${CASK_SLUG}" do
  version "${VERSION}"
  sha256 "${PKG_SHA}"

  url "https://github.com/${REPO}/releases/download/v#{version}/AudioCast-#{version}.pkg"
  name "AudioCast Driver"
  desc "Virtual audio device for AudioCast (BlackHole fork with AudioCast branding)"
  homepage "https://github.com/${REPO}"

  depends_on macos: :sonoma

  pkg "AudioCast-#{version}.pkg"

  uninstall pkgutil: "com.audiocast.driver"

  caveats <<~CAVEATS
${CASK_SIGNING_CAVEAT}    After install, restart your Mac or run:
        sudo killall coreaudiod

    Then check System Settings → Sound — you should see 'AudioCast' as
    an output device.
  CAVEATS

  zap trash: [
    "/Library/Audio/Plug-Ins/HAL/AudioCast.driver",
  ]
end
EOF

GIT_NAME="$(git -C "${PROJECT_ROOT}" config user.name)"
GIT_EMAIL="$(git -C "${PROJECT_ROOT}" config user.email)"

git add "Casks/${CASK_SLUG}.rb"
if git diff --cached --quiet; then
    echo ">> Cask unchanged"
else
    git -c user.name="${GIT_NAME}" -c user.email="${GIT_EMAIL}" \
        commit -q -m "${CASK_SLUG} ${VERSION}"
    git push -u origin main 2>/dev/null || git push origin main
    echo ">> Cask published to ${CASK_REPO}"
fi

echo ""
echo ">> Done."
echo ">> Release:  https://github.com/${REPO}/releases/tag/${TAG}"
echo ">> Cask:     https://github.com/${CASK_REPO}/blob/main/Casks/${CASK_SLUG}.rb"
echo ">> Install:  brew tap jobtools/tap && brew install --cask audiocast-driver"
